# ScamDrill environment variables (copy to .env and fill in real values)
# Never commit .env — it is gitignored.

# LLM provider selection: "nebius" or "openrouter"
LLM_PROVIDER=openrouter

# ---- OpenRouter (OpenAI-compatible) ----
# Used for initial testing. Get a key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Nebius Token Factory (OpenAI-compatible) ----
# Used for final test / deployment. Get a key in the Nebius Token Factory console.
NEBIUS_API_KEY=...
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model IDs (exact IDs from the provider catalog — do not hardcode in code)
MODEL_FAST=nvidia/Nemotron-3-Nano-30B-A3B
MODEL_REASON=nvidia/nemotron-3-super-120b-a12b

# Cost protection
DAILY_CALL_CAP=200

# Demo replay mode: "replay" serves demo/recorded_run.json; unset for live API
DEMO_MODE=

# App
APP_ENV=development